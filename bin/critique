#!/bin/sh
# Review a GitHub pull request in Neovim. See `critique -h`.
case "$1" in
  -h|--help)
    cat <<'HELP'
Usage: critique <pull-request-url>

Check out a GitHub pull request and review it in Neovim with critique.nvim.

Any PR link works, including GitHub Enterprise hosts and links to a specific
file, line, or comment:
  critique https://github.com/owner/repo/pull/123
  critique https://github.com/owner/repo/pull/123/changes#diff-<hash>R31
  critique https://github.example.com/team/repo/pull/7#discussion_r123456

Needs the GitHub CLI (gh). If you're not logged in to the PR's host,
critique runs `gh auth login --hostname <host>` first.

Inside Neovim: :Critique help, or :help critique.
HELP
    exit 0 ;;
  '') echo "usage: critique <pull-request-url>   (critique -h for help)" >&2; exit 1 ;;
esac
command -v gh >/dev/null || { echo "critique needs the GitHub CLI: https://cli.github.com" >&2; exit 1; }
host=$(printf '%s' "$1" | sed -E 's#^https?://([^/]+)/.*#\1#')
gh auth status --hostname "$host" >/dev/null 2>&1 || gh auth login --hostname "$host" || exit 1
exec nvim -c "Critique open $1"
